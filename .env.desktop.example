# Copy this file to .env.desktop.local. Never commit the local file.
# Create each account in Firebase Authentication and add users/<uid> in RTDB
# with role_id "device", role_ids ["device"], and status "active".

STI_LOCATOR_DESKTOP_DEVICE_PRODUCTION_EMAIL=device-prod@example.edu
STI_LOCATOR_DESKTOP_DEVICE_PRODUCTION_PASSWORD=replace-with-a-strong-unique-password
STI_LOCATOR_DESKTOP_ADMIN_PRODUCTION_EMAIL=desktop-admin-prod@example.edu
STI_LOCATOR_DESKTOP_ADMIN_PRODUCTION_PASSWORD=replace-with-a-different-strong-password

STI_LOCATOR_DESKTOP_DEVICE_STAGING_EMAIL=device-stg@example.edu
STI_LOCATOR_DESKTOP_DEVICE_STAGING_PASSWORD=replace-with-a-strong-unique-password
STI_LOCATOR_DESKTOP_ADMIN_STAGING_EMAIL=desktop-admin-stg@example.edu
STI_LOCATOR_DESKTOP_ADMIN_STAGING_PASSWORD=replace-with-a-different-strong-password

# These defaults match the local emulator seed account.
STI_LOCATOR_DESKTOP_DEVICE_LOCAL_EMAIL=device.local@sti.edu
STI_LOCATOR_DESKTOP_DEVICE_LOCAL_PASSWORD=Device@12345
STI_LOCATOR_DESKTOP_ADMIN_LOCAL_EMAIL=admin@sti.edu
STI_LOCATOR_DESKTOP_ADMIN_LOCAL_PASSWORD=Admin@12345
